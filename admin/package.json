{
  "name": "@aquafish/aqadmin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dev:force": "vite --host 127.0.0.1 --port 5173 --strictPort --force",
    "rebuild:esbuild": "pnpm rebuild esbuild",
    "clean:cache": "node -e \"const fs=require('node:fs'); for (const path of ['node_modules/.vite','.vite','.cache']) fs.rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aquafish/api-client": "workspace:*",
    "@aquafish/components": "workspace:*",
    "@aquafish/ui-shared": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
